# ========================
# DATABASE
# ========================
MONGODB_URI=mongodb://localhost:27017/portfolio

# ========================
# SESSION
# ========================
# 48-byte random secret used to sign JWT session tokens.
# Regenerate per environment with: openssl rand -base64 48
SESSION_SECRET=

# ========================
# ADMIN SEED CREDENTIALS
# These are used ONLY by the seed script to create the initial admin account.
# Remove or rotate after first login.
# ========================
ADMIN_EMAIL=admin@portfolio.dev
ADMIN_PASSWORD=

# ========================
# APP
# ========================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ========================
# WEBSOCKET
# ========================
WS_PATH=/ws

# ========================
# WEB PUSH (VAPID)
# Generate keys with: node -e "const w=require('web-push');console.log(JSON.stringify(w.generateVAPIDKeys()))"
# VAPID_PRIVATE_KEY must NEVER be exposed to the client.
# ========================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com

# ========================
# FRONTEND (NEXT_PUBLIC_*)
# These are bundled into client JavaScript.
# Only non-secret values here.
# ========================
NEXT_PUBLIC_WS_URL=ws://localhost:3000/ws
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ========================
# EMAIL (Nodemailer SMTP — Gmail)
# ========================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=maazulhaque26@gmail.com
SMTP_PASSWORD=

EMAIL_FROM=maazulhaque26@gmail.com
EMAIL_FROM_NAME=Maazul

# ========================
# CLOUDINARY (Media Storage)
# New uploads are stored here instead of local filesystem.
# Sign up at https://cloudinary.com and grab these from the Dashboard.
# ========================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
